<section class="inquiry-form-section" aria-labelledby="inquiry-heading" data-inquiry-component>
 <h2 id="inquiry-heading">Send an inquiry</h2>
 <p>Describe the items you would like evaluated. Do not include identification documents, banking information or other sensitive details. This form does not reserve an appointment.</p>
 <p data-inquiry-availability role="status">Checking online inquiry availability… You can also <a href="tel:+13106631340">call 310-663-1340</a> or <a href="mailto:cash4goldanddiamond@gmail.com">email us</a>.</p>
 <p><a href="tel:+13106631340">Call 310-663-1340</a> or <a href="mailto:cash4goldanddiamond@gmail.com">email cash4goldanddiamond@gmail.com</a> if you prefer, or if the online form is unavailable.</p>
 <form action="/api/inquiry/" method="post" data-inquiry-form hidden aria-describedby="inquiry-note">
  <div class="inquiry-grid">
   <div><label for="inquiry-name">Your name <span>(required)</span></label><input id="inquiry-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="100" required aria-describedby="inquiry-name-error"/><p id="inquiry-name-error" data-field-error="name" class="field-error"></p></div>
   <div><label for="inquiry-email">Email address <span>(required)</span></label><input id="inquiry-email" name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="inquiry-email-error"/><p id="inquiry-email-error" data-field-error="email" class="field-error"></p></div>
   <div><label for="inquiry-phone">Phone <span>(optional)</span></label><input id="inquiry-phone" name="phone" type="tel" autocomplete="tel" maxlength="35" aria-describedby="inquiry-phone-error"/><p id="inquiry-phone-error" data-field-error="phone" class="field-error"></p></div>
   <div><label for="inquiry-item">Item type <span>(required)</span></label><select id="inquiry-item" name="itemType" required aria-describedby="inquiry-item-error"><option value="">Choose an item type</option><option value="gold">Gold jewelry, scrap or coins</option><option value="diamonds">Natural diamonds or diamond jewelry</option><option value="watches">Rolex or another luxury watch</option><option value="estate">Estate, inherited or antique jewelry</option><option value="other">Another item or a mixed collection</option></select><p id="inquiry-item-error" data-field-error="itemType" class="field-error"></p></div>
  </div>
  <label for="inquiry-message">Tell us about your items <span>(required)</span></label><textarea id="inquiry-message" name="message" rows="5" minlength="10" maxlength="3000" required aria-describedby="inquiry-message-help inquiry-message-error"></textarea><p id="inquiry-message-help">10–3,000 characters. Describe the type and approximate quantity, and share your preferred contact method.</p><p id="inquiry-message-error" data-field-error="message" class="field-error"></p>
  <div class="inquiry-honeypot" aria-hidden="true"><label for="inquiry-website">Leave this field empty</label><input id="inquiry-website" type="text" name="website" tabindex="-1" autocomplete="off"/></div>
  <label class="inquiry-permission" for="inquiry-permission"><input id="inquiry-permission" type="checkbox" name="permission" required aria-describedby="inquiry-permission-error"/><span>I allow Cash 4 Gold &amp; Diamonds to use these details to respond to this inquiry. <a href="/privacy-policy/">Privacy information</a>.</span></label><p id="inquiry-permission-error" data-field-error="permission" class="field-error"></p>
  <div data-turnstile-container aria-label="Security check"></div><p data-field-error="turnstile" class="field-error" role="status"></p>
  <p id="inquiry-note">A phone or photo estimate can differ from a final offer after your actual items are examined.</p>
  <button type="submit" class="elementor-button" data-inquiry-submit disabled>Send inquiry</button>
  <p data-inquiry-status role="status" aria-live="polite" tabindex="-1"></p>
 </form>
 <noscript><p>The online form requires JavaScript for spam protection. Please <a href="tel:+13106631340">call 310-663-1340</a> or <a href="mailto:cash4goldanddiamond@gmail.com">email cash4goldanddiamond@gmail.com</a>.</p></noscript>
</section>
<script>import {initializeInquiryForm} from '../scripts/inquiry-form.mjs'; initializeInquiryForm();</script>
<style>
 .inquiry-form-section{margin:3rem 0;padding:clamp(1rem,4vw,2rem);border:1px solid #64717d;border-radius:12px;max-width:900px}.inquiry-form-section [hidden]{display:none!important}.inquiry-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.inquiry-form-section label{display:block;font-weight:650;margin:.7rem 0 .4rem}.inquiry-form-section label span{font-weight:400}.inquiry-form-section input:not([type=checkbox]),.inquiry-form-section select,.inquiry-form-section textarea{box-sizing:border-box;width:100%;min-height:48px;padding:.7rem;border:1px solid #697784;border-radius:5px;background:#fff;color:#162027;font:inherit}.inquiry-form-section input:focus-visible,.inquiry-form-section select:focus-visible,.inquiry-form-section textarea:focus-visible,.inquiry-form-section button:focus-visible{outline:2px solid #fff!important;outline-offset:0!important;box-shadow:0 0 0 4px #17232c!important}.inquiry-form-section .inquiry-permission{display:flex;align-items:flex-start;gap:.75rem}.inquiry-permission input{flex-shrink:0;width:24px;height:24px;margin:.25rem 0}.inquiry-form-section button{min-height:48px;cursor:pointer}.inquiry-form-section button:disabled{opacity:.6;cursor:wait}.inquiry-honeypot{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.field-error{color:#9f2020;background:#fff;margin:.25rem 0;font-size:.95rem}.field-error:empty{display:none}.inquiry-form-section [aria-invalid=true]{border:2px solid #9f2020!important}.inquiry-form-section [data-inquiry-status]:not(:empty){padding:1rem;background:#f5f1e7;color:#162027;border-radius:5px}.inquiry-form-section [data-turnstile-container]{margin:1rem 0;min-height:140px;max-width:100%}@media(max-width:600px){.inquiry-grid{grid-template-columns:1fr}.inquiry-form-section{padding:1rem}.inquiry-form-section button{width:100%}}
</style>
