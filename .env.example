# Leave blank to use the verified local source snapshot.
# Configure a private Sanity dataset. Read token is server/build-only.
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_READ_TOKEN=
SANITY_API_VERSION=2026-09-09

# Studio uses the same project and private dataset; no tokens here.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=

# Fail-closed preview defaults. Production is a separate owner-approved release.
SITE_ENV=preview
ENABLE_PRODUCTION_INDEXING=false
# Drafts are allowed only in private preview builds, never production.
SANITY_PERSPECTIVE=published

# Staging import only; keep unset during public builds and never expose in Studio.
SANITY_WRITE_TOKEN=

# Account verification is configured at build/deployment time, outside Git.
# Restore the existing owner values before an approved production release.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Only the local .cache/production-audit output may exercise production policy
# without the verified production CMS. This output is never a release candidate.
ISOLATED_PRODUCTION_AUDIT=false
