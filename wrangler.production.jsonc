// Initial deployment has no public routes; attach the reviewed zone routes only at cutover.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cash4gold-production",
  "main": "workers/inquiry/index.mjs",
  "compatibility_date": "2026-09-03",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "SITE_ENV": "production",
    "STAGING_STUDIO_ENABLED": "false",
    "INQUIRY_ENABLED": "false",
    "INQUIRY_PROVIDER": "resend",
    "INQUIRY_ALLOWED_ORIGINS": "https://cash4goldanddiamond.com",
    "INQUIRY_FROM": "inquiries@notify.cash4goldanddiamond.com",
    "INQUIRY_TO": "cash4goldanddiamond@gmail.com",
    "INQUIRY_TURNSTILE_SITE_KEY": ""
  },
  "ratelimits": [
    {
      "name": "INQUIRY_RATE_LIMITER",
      "namespace_id": "2026091401",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/inquiry/*",
      "/studio",
      "/studio/*"
    ],
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  }
}
